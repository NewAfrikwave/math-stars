// Prisma schema for the Math Stars 3rd grade learning app

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Parent or guardian account. Children never need their own email address.
model FamilyAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  status       String   @default("active") // active | suspended
  privacyAcceptedAt DateTime
  lastLoginAt  DateTime?
  lastActiveAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students Student[]
  devices  AccountDevice[]

  @@index([createdAt])
  @@index([lastActiveAt])
}

// A learner profile belonging to one family. familyId remains optional only so
// the existing access-code profiles can be migrated without losing data.
model Student {
  id        String   @id @default(cuid())
  familyId  String?
  name      String   @default("Star Learner")
  avatar    String   @default("fox")
  level     String   @default("grade3") // preschool | grade3
  totalStars Int     @default(0)
  streak    Int      @default(0)
  lastPlayedAt DateTime?
  lastCompletedAt DateTime? // last new passed lesson, used for streaks
  parentPin String?  // salted scrypt hash of optional parent PIN
  soundOn   Boolean  @default(true) // learner sound preference
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family      FamilyAccount? @relation(fields: [familyId], references: [id], onDelete: Cascade)

  progress    LessonProgress[]
  achievements Achievement[]
  tutorMessages TutorMessage[]
  dailyChallenges DailyChallenge[]
  activityEvents ActivityEvent[]
  rewardGoals RewardGoal[]

  @@index([familyId])
}

// A real-world reward chosen by a parent. Progress is derived from saved
// learning records so it cannot drift or be lost when a device changes.
model RewardGoal {
  id          String   @id @default(cuid())
  studentId   String
  title       String
  emoji       String   @default("🎁")
  description String?
  targetType  String   // lessons | stars | topic
  targetValue Int
  startValue  Int      @default(0)
  domainId    String?
  currentKey  String?  @unique // student id while current; null after claim/archive
  status      String   @default("active") // active | earned | claimed | archived
  earnedAt    DateTime?
  claimedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([createdAt])
}

// Privacy-safe browser/device presence. We intentionally store categories,
// not location, IP address, advertising IDs, or a raw user-agent string.
model AccountDevice {
  id          String   @id @default(cuid())
  scopeKey    String   // family account id, or "legacy" for the owner entrance
  familyId    String?
  deviceKey   String
  deviceType  String   // phone | tablet | desktop | tv | unknown
  platform    String
  browser     String
  launchMode  String   @default("browser") // browser | standalone | fullscreen
  installed   Boolean  @default(false)
  installedAt DateTime?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  visitCount  Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family FamilyAccount? @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([scopeKey, deviceKey])
  @@index([familyId])
  @@index([lastSeenAt])
  @@index([installed])
}

// Progress record per lesson (one row per student + lessonId combo)
model LessonProgress {
  id         String   @id @default(cuid())
  studentId  String
  lessonId   String
  status     String   @default("locked") // locked | available | in-progress | completed
  stars      Int      @default(0) // 0-3 stars earned
  bestScore  Int      @default(0) // best percentage correct
  attempts   Int      @default(0)
  lastScore  Int      @default(0)
  lastDifficulty String? // easy | challenge — last difficulty played
  completedAt DateTime?
  lastPlayedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
}

// One row per daily challenge attempt (one per calendar day)
model DailyChallenge {
  id         String   @id @default(cuid())
  studentId  String
  dateKey    String   // YYYY-MM-DD — ensures one attempt per day
  score      Int      @default(0) // percent
  correct    Int      @default(0)
  total      Int      @default(0)
  completedAt DateTime @default(now())

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, dateKey])
  @@index([studentId])
}

// Achievement badges earned by the student
model Achievement {
  id          String   @id @default(cuid())
  studentId   String
  achievementId String // logical id from code, e.g. "first-lesson"
  earnedAt    DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, achievementId])
  @@index([studentId])
}

// Saved AI tutor conversation messages
model TutorMessage {
  id        String   @id @default(cuid())
  studentId String
  role      String // user | assistant
  content   String
  context   String? // lesson context the question was asked in
  createdAt DateTime @default(now())

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// A timestamped activity event for the parent timeline (one row per practice
// session, daily challenge, or placement test).
model ActivityEvent {
  id        String   @id @default(cuid())
  studentId String
  type      String   // lesson | daily | placement
  lessonId  String?
  attemptId String?  @unique // stable client id makes progress retries idempotent
  title     String   // human-readable label, e.g. "Count to 5"
  emoji     String   @default("📘")
  score     Int      @default(0) // percent
  correct   Int      @default(0)
  total     Int      @default(0)
  stars     Int      @default(0) // stars earned (lesson only)
  createdAt DateTime @default(now())

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([createdAt])
}

// Site-wide settings (singleton row, id = "site"). Stores feature flags,
// donation handles, broadcast messages, and the admin PIN.
model SiteSettings {
  id              String   @id @default("site")
  adminPin        String?  // salted scrypt hash of separate admin PIN
  // Feature flags
  dailyChallengeEnabled Boolean @default(true)
  aiTutorEnabled        Boolean @default(true)
  voiceAnswersEnabled   Boolean @default(true)
  worksheetsEnabled     Boolean @default(true)
  manipulativesEnabled  Boolean @default(true)
  soundEffectsEnabled   Boolean @default(true)
  // Donation handles (editable from admin)
  cashappHandle   String   @default("")
  zelleInfo       String   @default("")
  // Broadcast banner
  broadcastMessage String?
  broadcastActive  Boolean @default(false)
  updatedAt       DateTime @updatedAt
}

// System error log — API routes can log errors here for the admin monitor.
model ErrorLog {
  id        String   @id @default(cuid())
  route     String   // e.g. "/api/tutor"
  method    String   // GET | POST
  message   String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([route])
}
